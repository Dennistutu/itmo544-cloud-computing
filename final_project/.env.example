# ---- account, network, instances (same as week 9) ----
AWS_REGION=us-east-2
AMI_ID=ami-xxxxxxxxxxxxxxxxx
KEY_NAME=ITMO-444-544-lab-keypair
INSTANCE_TYPE=t3.micro
APP_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
AZ_A=us-east-2a
AZ_B=us-east-2b
APP_PORT=3000
ALB_NAME=itmo-444-544-weather-alb
ALB_SG_NAME=itmo-444-544-weather-alb-sg

# ---- tiers (same names as week 9) ----
WEATHER_ROLE_NAME=itmo-444-544-weather-role
WEATHER_PROFILE_NAME=itmo-444-544-weather-profile
WEATHER_LT_NAME=itmo-444-544-weather-lt
WEATHER_TG_NAME=itmo-444-544-weather-tg
WEATHER_ASG_NAME=itmo-444-544-weather-asg
WEATHER_LISTENER_PORT=8080
ADVISOR_ROLE_NAME=itmo-444-544-advisor-role
ADVISOR_PROFILE_NAME=itmo-444-544-advisor-profile
ADVISOR_LT_NAME=itmo-444-544-advisor-lt
ADVISOR_TG_NAME=itmo-444-544-advisor-tg
ADVISOR_ASG_NAME=itmo-444-544-advisor-asg
ADVISOR_LISTENER_PORT=8081

# ---- final project: data stores ----
FACTS_TABLE=itmo-544-final-facts
ADVISOR_TABLE=itmo-544-final-advisor
SNS_TOPIC_NAME=itmo-544-final-reports
SALT_PARAM_NAME=/itmo-444-544/visitor-salt

# ---- Gemini (the key itself is only in SSM) ----
GEMINI_PARAM_NAME=/itmo-444-544/gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DAILY_CAP=200
KEY_CACHE_SECONDS=300

# ---- caching (seconds) ----
FACTS_FRESH_SECONDS=1800
FACTS_KEEP_SECONDS=21600
REPORT_SECONDS=1800

# ---- abuse limits ----
# Per connection (IP). A whole class may share one campus IP, so these are generous.
REPORT_LIMIT=60
REPORT_WINDOW_SECONDS=600
EMAIL_IP_LIMIT=30
# Per recipient address, whoever asks
EMAIL_LIMIT=3
EMAIL_WINDOW_SECONDS=3600

# ---- time limits (seconds); must stay under the ALB's 60 s idle timeout ----
OUTSIDE_TIMEOUT_SECONDS=6
WEATHER_TIMEOUT_SECONDS=25
GEMINI_TIMEOUT_SECONDS=15

# ---- service level objectives, measured by tests/integration/test_sli.py ----
SLO_HEALTH_MS=120
SLO_CACHED_MS=3000
SLO_NEW_MS=20000

# ---- cost (budget.py). About $0.07 per hour for this stack, as in lab06 ----
STACK_HOURLY_COST=0.07
PROJECT_BUDGET=2.00

# ---- other ----
CONTACT_EMAIL=you@example.com
RECOVERY_SLO_SECONDS=180
